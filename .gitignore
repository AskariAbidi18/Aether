.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.hypothesis/
.coverage
.coverage.*
htmlcov/

# Jupyter
.ipynb_checkpoints/

# ----------------------------
# IDE
# ----------------------------
.vscode/
.idea/

*.swp
*.swo
*~

# ----------------------------
# OS
# ----------------------------
.DS_Store
Thumbs.db
desktop.ini

# ----------------------------
# Environment Variables
# ----------------------------
.env
.env.*
!.env.example

# ----------------------------
